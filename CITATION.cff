    given-names: Kawser
    affiliation: "Department of Electrical and Computer Engineering, North South University"
year: 2026
license: MIT
repository-code: "https://github.com/kawsersikder/NHL-DLBCL"
keywords:
  - diffuse large B-cell lymphoma
  - computational pathology
  - survival analysis
  - pre-registration
  - reproducibility
  - data leakage
